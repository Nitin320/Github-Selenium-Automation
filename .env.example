# ============================================================
# GitHub Selenium Automation — Local credentials template
# Author: Arsath
#
# USAGE:
#   1. Copy this file to .env  (never commit .env — it is in .gitignore)
#   2. Fill in your real GitHub credentials below.
#   3. The .env file is loaded automatically by ConfigReader at runtime.
#
# NOTE: These values are ONLY for local development.
#       In CI (GitHub Actions) the secrets are injected via
#       Settings → Secrets → GITHUB_USERNAME / GITHUB_PASSWORD.
# ============================================================

GITHUB_USERNAME=your_github_username_here
GITHUB_PASSWORD=your_github_password_here
