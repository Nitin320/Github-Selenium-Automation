package pages;

import org.openqa.selenium.By;

/**
 * GistListPage — page object for the GitHub Gist homepage/list.
 *
 * Handles:
 * - Opening the Gist page
 * - Opening New Gist
 * - Checking whether a Gist exists
 * - Opening an existing Gist
 *
 * Author: Naveen
 */
public class GistListPage extends BasePage {

    private final By newGistButton =
            By.id("gists-header-new-gist");

    private final By flashMessage =
            By.cssSelector("#js-flash-container [role='alert'], #js-flash-container .flash");

    /**
     * Checks whether a flash message is displayed on the list page.
     */
    public boolean isFlashMessageDisplayed() {
        return isDisplayed(flashMessage);
    }

    /**
     * Gets the flash message text displayed on the list page.
     */
    public String getFlashMessage() {
        return getText(flashMessage);
    }

    /**
     * Opens GitHub Gist homepage.
     */
    public GistListPage open() {

        navigateTo("https://gist.github.com/");

        return this;
    }

    /**
     * Navigates directly to the new Gist creation form URL.
     * This is more reliable than clicking the New Gist button on the list page,
     * which may not render consistently after login redirects.
     */
    public GistCreatePage clickNewGist() {

        navigateTo("https://gist.github.com/new");

        return new GistCreatePage();
    }

    /**
     * Checks whether a Gist with the supplied name exists.
     */
    public boolean isGistPresent(String gistName) {

        By gistLocator = By.xpath(
                "//a[normalize-space()=" + xpathLiteral(gistName) + "]"
        );

        return isDisplayed(gistLocator);
    }

    /**
     * Opens a Gist by clicking its displayed name link.
     * Use this to navigate directly into an existing gist from the list page.
     */
    public GistViewPage openGist(String gistName) {

        By gistLocator = By.xpath(
                "//a[normalize-space()=" + xpathLiteral(gistName) + "]"
        );

        click(gistLocator);

        return new GistViewPage();
    }

    /**
     * Creates a safe XPath string literal.
     */
    private String xpathLiteral(String value) {

        if (!value.contains("'")) {
            return "'" + value + "'";
        }

        if (!value.contains("\"")) {
            return "\"" + value + "\"";
        }

        String[] parts = value.split("'", -1);

        StringBuilder result =
                new StringBuilder("concat(");

        for (int i = 0; i < parts.length; i++) {

            if (i > 0) {
                result.append(", \"'\", ");
            }

            result.append("'")
                    .append(parts[i])
                    .append("'");
        }

        result.append(")");

        return result.toString();
    }
}
