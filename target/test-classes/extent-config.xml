<?xml version="1.0" encoding="UTF-8"?>
<!--
  ExtentReports 5 configuration — Group 5 GitHub Selenium Automation
  Loaded by ExtentSparkReporter inside ReportManager.java.
  Report is written to: target/reports/ExtentReport_<timestamp>.html
-->
<extentreports>
    <configuration>
        <!-- Visual theme: DARK or STANDARD -->
        <theme>DARK</theme>
        <encoding>UTF-8</encoding>

        <!-- Browser tab title -->
        <documentTitle>Group 5 — GitHub Automation Report</documentTitle>

        <!-- Report header displayed inside the HTML -->
        <reportName>GitHub Selenium Automation</reportName>

        <!-- Timestamp format used throughout the report -->
        <timeStampFormat>MMM dd, yyyy HH:mm:ss</timeStampFormat>

        <!-- CSS overrides (optional — keep blank to use defaults) -->
        <css></css>

        <!-- JS overrides (optional) -->
        <js></js>
    </configuration>
</extentreports>